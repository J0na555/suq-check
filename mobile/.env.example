# Deployed API. Leave unset to use the same URL the client defaults to.
EXPO_PUBLIC_API_URL=https://suq-check-api.onrender.com

# Point at a backend running on your machine instead. Use your LAN IP rather
# than 127.0.0.1 when testing on a phone: the phone is not the host.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
