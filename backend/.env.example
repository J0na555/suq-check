ENVIRONMENT=development
USE_FIXTURES=true
CORS_ORIGINS=*

# Use Neon's pooled URL (-pooler in the hostname) for the running API.
DATABASE_URL=
# Use the direct URL for Alembic migrations.
MIGRATION_DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# Added in the Gemini integration step.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

